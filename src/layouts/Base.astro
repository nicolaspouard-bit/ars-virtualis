---
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import { SITE } from '../config';

interface Props {
  titre?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { titre, description = SITE.description, type = 'website' } = Astro.props;
const titreComplet = titre ? `${titre} | ${SITE.sousTitre}` : `${SITE.sousTitre} | ${SITE.titre}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.auteur} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.sousTitre} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={titre ?? SITE.sousTitre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={SITE.sousTitre} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />

    <!-- Thème clair/sombre appliqué avant l'affichage, pour éviter le clignotement. -->
    <script is:inline>
      (function () {
        var choix = null;
        try { choix = localStorage.getItem('theme'); } catch (e) {}
        if (choix !== 'light' && choix !== 'dark') {
          choix = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = choix;
      })();
    </script>
  </head>
  <body>
    <a class="aller-au-contenu" href="#contenu">Aller au contenu</a>
    <Entete />
    <main id="contenu">
      <div class="cadre">
        <slot />
      </div>
    </main>
    <Pied />
  </body>
</html>
